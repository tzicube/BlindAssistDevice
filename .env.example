# =============================================================================
# BLIND ASSIST DEVICE - UNIFIED SERVER / AI / FRONTEND
# Copy this file to .env and replace paths or model names for the target machine.
# Never commit real secrets.
# =============================================================================

# Unified HTTP service: dashboard backend + camera frame API + AI recognize API
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
CAMERA_FPS=30

# Frontend (Vite reads the root .env through Frontend1/vite.config.js)
FRONTEND_URL=http://localhost:5173
VITE_PORT=5173
# Leave these empty to use the same hostname as the dashboard (LAN-safe).
VITE_API_URL=
VITE_WS_URL=
VITE_CAMERA_URL=
VITE_CAMERA_FPS=30
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse

# Ollama multimodal inference
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_image_processing_MODEL=gemma3:27b
# Load the model during server startup and keep it in memory until shutdown.
# -1 means no automatic expiry; values such as 30m are also accepted.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_STARTUP_TIMEOUT_SECONDS=600

# Whisper speech-to-text
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=5

# Local text-to-speech. The default uses the installed Taiwan Windows voice.
TTS_ENGINE=windows
WINDOWS_TTS_VOICE=Microsoft Hanhan Desktop - Chinese (Taiwan)
WINDOWS_TTS_RATE=0
WINDOWS_TTS_VOLUME=100
WINDOWS_TTS_TIMEOUT_SECONDS=60

# Optional Piper fallback (.onnx and matching .onnx.json must exist)
PIPER_MODEL_PATH=AiServer/models/zh_CN-huayan-medium.onnx
AI_RESPONSE_LANGUAGE=Traditional Chinese (zh-TW)
AI_ASSISTANT_NAME=BlindAssist
AI_ASSISTANT_ROLE=assistive visual and situational-awareness AI
AI_ASSISTANT_AUDIENCE=a blind or low-vision user
AI_ASSISTANT_TASK=analyze the latest camera image, answer the user's spoken question, identify relevant objects or obstacles, and prioritize urgent hazards
AI_OPERATION_CONTEXT=the BlindAssist smart-glasses system with a live camera and GPS
AI_OPERATION_REGION=Taiwan

# Optional/reserved. The current local pipeline uses Ollama, not OpenAI.
OPENAI_API_KEY=

# Public deployment example
# FRONTEND_URL=https://dashboard.example.com
# VITE_API_URL=https://api.example.com
# VITE_CAMERA_URL=https://api.example.com
